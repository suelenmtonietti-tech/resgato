{
  "cleanUrls": true,
  "headers": [
    { "source": "/assets/(img|video)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" } ] },
    { "source": "/assets/(css|js)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
